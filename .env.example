# Copy to .env.local and fill in what you need. Everything is optional:
# without these, SongCraft Studio runs fully local (IndexedDB) and the
# rule-based tools work; AI features show as "not configured".

# ---- AI provider (server-side only; never exposed to the browser) ----
# AI_PROVIDER=anthropic          # "anthropic" (default when a key is set) or "none" to disable AI
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- Supabase (reserved for cloud sync; not used by this build yet) ----
# See supabase/migrations and the README "Cloud sync" section.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
